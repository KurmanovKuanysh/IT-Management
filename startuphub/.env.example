# Строка подключения к PostgreSQL (для scripts/devdb.sh подходит как есть)
DATABASE_URL="postgresql://startuphub@127.0.0.1:5434/startuphub"
# Прямое подключение для миграций (на Neon — строка без -pooler)
DATABASE_URL_UNPOOLED="postgresql://startuphub@127.0.0.1:5434/startuphub"

# Секрет для подписи JWT: минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-32+"

# Админ, которого создаёт seed
SEED_ADMIN_EMAIL="admin@startuphub.local"
SEED_ADMIN_PASSWORD="admin12345"
