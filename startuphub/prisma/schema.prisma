generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Прямое подключение без пулера — для миграций. Имя совпадает с тем,
  // что создаёт интеграция Neon в Vercel; локально — та же строка, что DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  FOUNDER
  ADMIN
}

enum StartupStatus {
  DRAFT
  PUBLISHED
}

enum Industry {
  FINTECH
  EDTECH
  HEALTHTECH
  ECOMMERCE
  AI_ML
  GREENTECH
  GAMING
  SOCIAL
  LOGISTICS
  OTHER
}

enum Stage {
  IDEA
  PROTOTYPE
  MVP
  EARLY_REVENUE
  GROWTH
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  bio          String?
  avatarUrl    String?
  role         Role      @default(FOUNDER)
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startups     Startup[]
}

model Startup {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  name         String
  tagline      String
  description  String
  industry     Industry
  stage        Stage
  logoUrl      String?
  websiteUrl   String?
  pitchDeckUrl String?
  contactEmail String
  location     String?
  teamSize     Int?
  foundedYear  Int?
  status       StartupStatus @default(DRAFT)
  isHidden     Boolean       @default(false)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownerId      String        @db.Uuid
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status, isHidden, createdAt])
  @@index([industry])
  @@index([stage])
  @@index([ownerId])
}
